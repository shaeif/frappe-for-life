# Copy to .env and change the passwords:  cp .env.example .env
SITE_NAME=labqubit.localhost
ADMIN_PASSWORD=change-me-admin
DB_ROOT_PASSWORD=change-me-db
HTTP_PORT=8080
# Seed services, solutions, industries and unpublished samples on first start (1/0)
SEED_DEMO=1

# --- production only (compose.prod.yml) ---
# SITE_NAME must equal DOMAIN in production, e.g. SITE_NAME=labqubit.com
# DOMAIN=labqubit.com
# LETSENCRYPT_EMAIL=it@labqubit.com
# BACKUP_RETENTION_DAYS=14
# Off-site backups with restic (optional), e.g. an S3 bucket:
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/your-bucket/labqubit
# RESTIC_PASSWORD=long-random-passphrase
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
