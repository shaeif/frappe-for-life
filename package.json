{
  "name": "labqubit",
  "private": true,
  "description": "Frontend build for the LabQubit Frappe app",
  "scripts": {
    "vendor": "node scripts/vendor-assets.mjs",
    "dev": "node scripts/vendor-assets.mjs && tailwindcss -i ./styles/tailwind.css -o ./labqubit/public/css/labqubit.css --watch",
    "build": "node scripts/vendor-assets.mjs && tailwindcss -i ./styles/tailwind.css -o ./labqubit/public/css/labqubit.css --minify"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "lucide-static": "^1.52.0",
    "tailwindcss": "^4.3.3"
  }
}
