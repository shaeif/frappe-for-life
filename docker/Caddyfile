# HTTPS in front of the LabQubit stack (compose.prod.yml). Certificates come from
# Let's Encrypt automatically once DNS for $DOMAIN points at this server.
{
	email {$LETSENCRYPT_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Content-hashed URLs (asset_url adds ?v=...) never change: cache for a year
	@versioned {
		path /assets/*
		query v=*
	}
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	# Other static assets (fonts, Frappe bundles): a week, unless the app set a header
	@assets path /assets/*
	header @assets ?Cache-Control "public, max-age=604800"

	header {
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	reverse_proxy frontend:8080
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
